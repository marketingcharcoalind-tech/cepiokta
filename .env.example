# === MODE ===
MODE=readonly # readonly | backtest | paper | live
LIVE_CONFIRMED=no # MUST remain no outside approved live phase

# === WALLET / CHAIN (SECRET values belong only in local .env) ===
POLYGON_RPC_URL=
POLYGON_RPC_FALLBACKS=https://polygon-bor-rpc.publicnode.com,https://polygon-mainnet.public.blastapi.io,https://polygon.blockpi.network/v1/rpc/public
POLYGON_RPC_TIMEOUT_SECONDS=10
WALLET_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# === ENDPOINTS ===
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_REST_URL=https://clob.polymarket.com
CLOB_WSS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_APP_PING_SECONDS=10
WS_STALE_SECONDS=30
RESOLVE_POLL_SECONDS=30
GAMMA_DISCOVERY_RETRY=true
GAMMA_DISCOVERY_MAX_BACKOFF_SECONDS=15
PRICE_SAMPLE_SECONDS=2.0
PRICE_SAMPLE_TAIL_SECONDS=0.5
PRICE_SAMPLE_TAIL_WINDOW=60
PRICE_SAMPLE_FORCE_SECONDS=25.0
CHAINLINK_BTCUSD_SOURCE=0xc907E116054Ad103354f2D350FD2514433D57F6f
CHAINLINK_FEED_TYPE=data_feed
CHAINLINK_MAX_STALENESS_SEC=120

# === RETENTION ===
BOOK_PERSIST_MODE=changes
BOOK_SAMPLE_MS=1000
BOOK_FINEGRAIN_SEC=45
BOOK_DRAIN_SECONDS=3
BOOK_POLL_SECONDS=1.0
RECORDER_HEARTBEAT_SECONDS=15

# === STRATEGY DEFAULTS (paper candidate is configured in VPS .env) ===
T_ENTRY_SEC=20
DELTA_THRESHOLD=auto
MIN_PRICE=0.80
MAX_PRICE=0.99
MIN_EDGE=0.01
FLIP_RATIO=0.90
HEDGE_FRACTION=0.5
P_EXIT=0.65
FEE_RATE=0.07
FEE_EXPONENT=1

# === SIZING & RISK ===
BANKROLL_FLOOR=50
MAX_NOTIONAL_ROUND=5
MAX_BANKROLL_FRACTION=0.02
FILL_SAFETY=0.8
MAX_OPEN_EXPOSURE=10
MAX_DAILY_LOSS_PCT=5
MAX_CONSEC_LOSSES=5
KELLY_FRACTION=0.25
MAX_ORDERS_PER_MIN=30
STALE_MS=1500

# === PAPER TRADING ===
PAPER_TRADING=true
PAPER_STARTING_BALANCE=200

# === BACKTEST / PAPER EXECUTION ASSUMPTIONS ===
BACKTEST_SEED=42
BACKTEST_LATENCY_TICKS=1
BACKTEST_COMPETITION_FRACTION=0
BACKTEST_VOL_PER_SQRT_SEC=5

# === INFRA ===
DB_URL=sqlite+aiosqlite:///./btcbot.db
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=

# === TELEGRAM (all real values belong only in VPS .env) ===
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_PER_ROUND_NOTIFY=true
TELEGRAM_HEARTBEAT_MIN=30
TELEGRAM_DAILY_SUMMARY=true

# === MULTI-MARKET (disabled operationally until Phase 4) ===
MARKETS_CONFIG=./markets.yaml
MAX_OPEN_EXPOSURE_MARKET=10
MAX_OPEN_EXPOSURE_ASSET=15
MAX_CORRELATED_DIRECTIONAL=20
MAX_OPEN_EXPOSURE_GLOBAL=30
CHAINLINK_ETHUSD_SOURCE=
CHAINLINK_SOLUSD_SOURCE=
